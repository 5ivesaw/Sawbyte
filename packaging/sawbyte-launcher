#!/bin/sh
# Sawbyte Native Desktop Launcher + Companion CLI Terminal Runner (Linux & Unix)
DIR="$(cd "$(dirname "$0")" && pwd)"
export PATH="$DIR:$HOME/.sawbyte/bin:$HOME/.local/bin:$PATH"

if [ -x "$DIR/sawbyte" ]; then
    exec "$DIR/sawbyte" launcher gui "$@"
else
    exec sawbyte launcher gui "$@"
fi

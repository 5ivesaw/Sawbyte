{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sawbyte Launcher",
  "version": "0.5.2",
  "identifier": "dev.fivesaw.sawbyte.launcher",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sawbyte Launcher — Rust + Tauri 26.3",
        "width": 1340,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
